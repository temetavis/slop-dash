static func get_level_count() -> int:
	return levels.size()

static func get_level(index: int) -> Dictionary:
	if index < 0 or index >= levels.size():
		return {}
	return levels[index]

static func parse_map(map_text: String) -> Array:
	var lines: Array = []
	var max_width := 0
	for raw_line in map_text.strip_edges().split("\n"):
		var line: String = raw_line.strip_edges()
		if line.is_empty():
			continue
		lines.append(line)
		max_width = maxi(max_width, line.length())
	var grid: Array = []
	for y in range(lines.size() + 2):
		var row: Array = []
		row.resize(max_width + 2)
		for x in range(max_width + 2):
			var is_border: bool = y == 0 or y == lines.size() + 1 or x == 0 or x == max_width + 1
			row[x] = STEEL if is_border else EMPTY
		grid[y] = row
	for y in range(lines.size()):
		var line: String = lines[y]
		for x in range(line.length()):
			grid[y + 1][x + 1] = line[x]
	return grid
